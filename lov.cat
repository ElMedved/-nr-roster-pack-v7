"selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="5960f18b-2a19-5e82-9b2e-b800487fa105" type="max"/></constraints><costs><cost typeId="points" name="pts" value="20"/></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups><costs><cost typeId="points" name="pts" value="70"/></costs></selectionEntry></selectionEntries><selectionEntryGroups></selectionEntryGroups><costs><cost typeId="points" name="pts" value="0"/></costs></selectionEntry><selectionEntry id="5cda2633-b4c6-5d61-9a70-4c21fdb1c1b6" name="Kapricus Carrier" publicationId="79c0cbf6-2602-pub1" hidden="false" collective="false" type="unit"><categoryLinks><categoryLink id="4895d135-e6a2-5fd4-9c71-a8586732e661" targetId="c274d0b0-5866-44bc-9810-91c136ae7438" primary="true"/></categoryLinks><infoLinks><infoLink id="a6a5a148-fbdc-5889-aab3-01bfd2c71d2a" name="Void Armour" hidden="false" targetId="d5b2e5cb-c357-5391-9fd2-1907749c3a7d" type="rule"/><infoLink id="30196174-e87c-5848-bd5f-c63862927c3c" name="Kapricus Carrier Transport" hidden="false" targetId="ad811001-36c6-565a-baaf-cce90bfe4e7b" type="profile"/></infoLinks><constraints></constraints><selectionEntries><selectionEntry id="6c0e47c5-97fd-57d5-97a7-d191f378d65a" name="Kapricus Carrier" hidden="false" collective="false" type="model"><infoLinks><infoLink id="36a27008-b49b-54ab-bd7c-bbf463ea6dd5" name="Kapricus Carrier" hidden="false" targetId="2917aa1e-342e-5a15-80fb-45c0052da2bb" type="profile"/><infoLink id="96e72a89-c4cb-576f-a15e-770e85d68251" name="Autocannon" hidden="false" targetId="fa99-0671-b31a-22d7" type="profile"/><infoLink id="feb24eee-60e0-5622-81df-1e70a86bbf44" name="Twin-linked Autocannon" hidden="false" targetId="6de0da50-cc91-5590-987c-8cf39ed7d2c7" type="profile"/><infoLink id="741dd823-b689-5d97-80bb-3d72992997c7" name="Smoke Launcher" hidden="false" targetId="c883-3078-1367-cc2c" type="profile"/><infoLink id="603ddad1-10ae-56e6-9810-d9268e3cbb38" name="Searchlight" hidden="false" targetId="4b04-2a83-8ae7-d134" type="profile"/><infoLink id="4f766683-d0f9-5c50-9e44-132b97cafb05" name="Twin-Linked" hidden="false" targetId="3002-de38-7230-fbc6" type="rule"/></infoLinks><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="8b111774-5ff2-5208-a32e-c67acd3a2316" type="min"/><constraint field="selections" scope="parent" value="3" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="495ad341-7c2d-5a0f-88a1-43e2ddebc8ea" type="max"/></constraints><costs><cost typeId="points" name="pts" value="45"/></costs></selectionEntry></selectionEntries><selectionEntryGroups></selectionEntryGroups><costs><cost typeId="points" name="pts" value="0"/></costs></selectionEntry></sharedSelectionEntries><sharedRules><rule id="0be9917b-9816-51c7-8f9e-662ff3c97184" name="Eye of the Ancestors" publicationId="79c0cbf6-2602-pub1" hidden="false"><description>Whenever an enemy destroys one of your units or slays a model with the character unit subtype in a challenge, that enemy has caught the ire of the Votann. Place a Grudge token next to it to denote this effect. Each enemy unit tracks their own Grudge tokens separately, up to a maximum of three per enemy unit. Independent Characters attached to units use the Grudge tokens of the unit they are attached to. If an enemy Independent Character leaves their unit, they gain the same amount of Grudge tokens that their unit had prior. Conversely, if an enemy Independent Character with Grudge tokens attaches themselves to a unit, use the higher of the Grudge token pools between them and discard the other.

Your Leagues of Votann units gain stacking bonuses depending on how many Grudge tokens the target enemy unit has:
1 Token: Leagues of Votann units are Stubborn while engaged with an enemy unit with a Grudge token.
2 Tokens: Leagues of Votann units suffer Hatred against an enemy unit with 2 tokens.
3 Tokens: Leagues of Votann units gain the Preferred Enemy special rule against an enemy unit with 3 tokens.

In addition, characters with this rule cannot refuse challenges. If an enemy issues a challenge, a character model with this rule must accept the challenge. (The Ancestors are Watching)</description></rule><rule id="cfacb955-59ae-53e1-b64d-1b6ab6bf5bab" name="Assistant" publicationId="79c0cbf6-2602-pub1" hidden="false"><description>A model with this rule does not prevent their attached character from joining another unit, this model simply joins the same unit as well.</description></rule><rule id="6713b987-f647-5bad-ab54-3b6986b87ac1" name="Brôkhyr's Guild" publicationId="79c0cbf6-2602-pub1" hidden="false"><description>In your shooting phase, instead of firing weapons, a model with this rule can repair a vehicle that they are embarked upon or in base contact with. To repair, roll a D6 and add +1 for each E-COG in the unit. On a 5+, either restore a hull point or remove a Weapon Destroyed or Immobilised result from that vehicle. If this unit contains an Ironkin Assistant, you can pick two different effects on a successful repair roll, but not 2 of the same.</description></rule><rule id="d2437f44-7529-5537-b4fd-6efc11988453" name="Companion" publicationId="79c0cbf6-2602-pub1" hidden="false"><description>Models with this rule are not targetable in any way. Models with this rule do not block line of sight and other models may move over and through models with this rule. When the attached character and their unit moves, place these models as close as possible to the attached character. When the attached character is slain, remove these models with this rule. Models with this rule may make attacks in the shooting/combat phase, in which case they can target any eligible models that their attached character can target. Models with this rule never gain the benefits for assaulting.</description></rule><rule id="1bf6153b-7b07-5ed9-9e4a-9b9e8f828d32" name="Cyberstimms" publicationId="79c0cbf6-2602-pub1" hidden="false"><description>When slain in combat, a model with this rule is not removed as a casualty until after it makes its attacks this combat phase. If the model has already attacked when it was slain, then this rule does not take effect.</description></rule><rule id="f28e1cdf-8a7e-5eda-b884-815caa725579" name="Experimental Munitions" publicationId="79c0cbf6-2602-pub1" hidden="false"><description>Boltguns, Bolt Pistols, and Heavy Bolters in a unit with a model with this rule gain the Poisoned (4+) special rule.</description></rule><rule id="d10effc8-39dc-57dd-aff9-f9c386953932" name="Grim Efficiency" publicationId="79c0cbf6-2602-pub1" hidden="false"><description>After deploying but before rolling to seize the initiative, as long as you have a model with this rule in your army, place a single Grudge Token on an enemy unit.</description></rule><rule id="122a9699-2183-5883-9e91-dc3c33951774" name="Mounted Assault" publicationId="79c0cbf6-2602-pub1" hidden="false"><description>When deploying a unit with this rule that has purchased dedicated transports, you may split the squad into separate units. Split the squad so that each vehicle has its transport capacity as filled as possible. The dedicated transports and the models embarked within them are then considered separate units for all intents and purposes. Any remaining models that cannot embark upon the dedicated transports remain as their own separate unit.</description></rule><rule id="3f4138ef-19fc-54da-815a-2269f4457302" name="Resolute" publicationId="79c0cbf6-2602-pub1" hidden="false"><description>Units with this special rule roll 3D6 when taking leadership tests, discarding the highest die.</description></rule><rule id="86365ca1-cc02-51de-84a2-5086670d1ef0" name="Retinue" publicationId="79c0cbf6-2602-pub1" hidden="false"><description>Characters with this rule do not take up a force organization slot. Instead, for every HQ taken, you may take one Character with this rule. What units these Characters may deploy within are indicated on their Datasheet. Only a single model with this rule may be attached to the same unit, and a model with this rule may not be nominated as your warlord.</description></rule><rule id="daa44f86-62a8-5c1c-b307-6b52a695a105" name="Spark of the Votann" publicationId="79c0cbf6-2602-pub1" hidden="false"><description>See "Power of the Machine Spirit" in the main rulebook.</description></rule><rule id="c2e3ce83-6b08-5142-b605-45042ed63f04" name="Steady Advance" publicationId="79c0cbf6-2602-pub1" hidden="false"><description>A unit composed entirely of models with this rule do not count as having moved while in the shooting phase. Whenever a unit with this rule declares to Run in the shooting phase, always move 3" instead of rolling to determine the distance. (Commonly found on most Leagues of Votann units.)</description></rule><rule id="dc10a05d-8ea2-52f8-a134-219003695e5d" name="Swivel Actuators" publicationId="79c0cbf6-2602-pub1" hidden="false"><description>Sponson weapons on a vehicle with this rule have a 180 field of fire rather than the usual 90 degrees.</description></rule><rule id="d5b2e5cb-c357-5391-9fd2-1907749c3a7d" name="Void Armour" publicationId="79c0cbf6-2602-pub1" hidden="false"><description>Models with this special rule automatically pass Dangerous Terrain tests. In addition, vehicles with this rule count as having Extra Armour. (Commonly found on most Leagues of Votann units.)</description></rule><rule id="1c5d62c7-a498-5046-b5fe-ee493837a7a4" name="Destiny Unfulfilled" publicationId="79c0cbf6-2602-pub1" hidden="false"><description>Ûthar the Destined can re-roll either a single die To Hit, To Wound or a Saving Throw once per turn.</description></rule><rule id="417bea3d-0d74-513e-80c4-edde294c0b4f" name="Waaaghbreaker" publicationId="79c0cbf6-2602-pub1" hidden="false"><description>Berehk Stornbröw and the unit he joins gain the Preferred Enemy (Orks) special rule. While an enemy Ork WAAAGH! is active, your entire army gains the Preferred Enemy (Orks) special rule.</description></rule><rule id="8ca22bcb-5c27-5d95-9af6-1898d4b19710" name="Thrice Devoured" publicationId="79c0cbf6-2602-pub1" hidden="false"><description>Whenever Buri Aegnirssen loses his last Wound, roll 2D6. If the combined result is equal to or less than the total number of Grudge tokens on the battlefield, Buri is not removed as a casualty and lives on with one Wound remaining.</description></rule><rule id="3b542d18-2967-5134-85eb-e73259eca830" name="Darkstar" publicationId="79c0cbf6-2602-pub1" hidden="false"><description>Wounds caused by this weapon cannot be negated by the Feel No Pain special rule.</description></rule><rule id="e969a31e-0c7d-5658-a4d4-75afeb0b82b3" name="Deflagrate" publicationId="79c0cbf6-2602-pub1" hidden="false"><description>After normal attacks by this weapon have been resolved, count the number of unsaved Wounds caused on the target unit. Immediately resolve a number of additional automatic hits on the same unit using the weapon's profile equal to the number of unsaved Wounds - these can then be saved normally. Models in the targeted unit must still be in range in order for these additional hits to take effect. These additional hits do not themselves inflict more hits!</description></rule><rule id="e3281d53-bb1e-5346-aab0-70547da33c40" name="Subterranean" publicationId="79c0cbf6-2602-pub1" hidden="false"><description>This weapon may only ever be fired indirectly. When firing at vehicles, the lowest Armour Value is hit rather than the usual rules for facing.</description></rule><rule id="eaf50a50-3e94-571d-8b09-89b7fecb85e1" name="Sunder" publicationId="79c0cbf6-2602-pub1" hidden="false"><description>Attacks with this special rule may re-roll failed Armour Penetration rolls.</description></rule><rule id="f5748963-0fe5-5748-9712-a42868f58a05" name="Quake" publicationId="79c0cbf6-2602-pub1" hidden="false"><description>In addition to any other damage, any non-vehicle unit hit by one or more weapons with this special rule must Treat Open Ground as Difficult Terrain and Difficult Terrain as Dangerous Terrain until the end of its next turn.</description></rule><rule id="c95c4c19-5fc4-5803-9b14-c0f72e4b84d5" name="HunTR" publicationId="79c0cbf6-2602-pub1" hidden="false"><description>Unsaved wounds caused by this weapon of unmodified rolls of '6' when rolling to wound or to penetrate armour, inflict an additional wound or an additional hull point if the target was a vehicle.</description></rule><rule id="83c6488c-fabd-5b5a-ba27-07a01e7cf026" name="Brawler" publicationId="79c0cbf6-2602-pub1" hidden="false"><description>For each initial attack that successfully hits with this weapon, roll an additional attack before rolling To Wound.</description></rule><rule id="ba311961-aa75-5802-8e1f-6e1a5a7bf4f8" name="Forge-stryke" publicationId="79c0cbf6-2602-pub1" hidden="false"><description>This weapon's Rending special rule applies on To Wound rolls of 4+.</description></rule><rule id="e1d3e111-7b0e-54e5-bbb2-fbb52ab7d7bf" name="Vengeance" publicationId="79c0cbf6-2602-pub1" hidden="false"><description>When attacking, the wielder rolls an additional Attack for every Grudge Token on the enemy unit.</description></rule><rule id="3ff1be6e-9dd5-5993-85fe-7a0e720ef705" name="Votann Diplomacy" publicationId="79c0cbf6-2602-pub1" hidden="false"><description>Against To Wound rolls of 6, enemies may not make Invulnerable saving throws.</description></rule><rule id="56f05ac3-2da2-51b0-beab-149042219811" name="Enmity Protocols" publicationId="79c0cbf6-2602-pub1" hidden="false"><description>Add 1 to the number of shots and strength of this weapon for each Grudge token on the targeted enemy unit.</description></rule><rule id="057e07fc-ad3d-516b-aeb5-9dc714feff82" name="Searing Strike" publicationId="79c0cbf6-2602-pub1" hidden="false"><description>Instead of attacking normally, the bearer may unleash a torrent of plasma. Place the flame template with the wide end in base contact with the bearer, angled in any direction that does not hit friendly models. All enemies hit by the template suffer a S4 AP4 automatic Hit.</description></rule><rule id="e652493e-bff2-5694-b4c0-ad77c6a983db" name="Ancestral Guidance" publicationId="79c0cbf6-2602-pub1" hidden="false"><description>When manifesting a psychic power against an enemy unit, you may reroll a die during the attempt for every Grudge token on that enemy unit.</description></rule><rule id="eb04cd19-8333-5b23-9eb9-1ae092230bf1" name="Shatter" publicationId="79c0cbf6-2602-pub1" hidden="false"><description>To Wound rolls of 6 are resolved as having the Instant Death special rule.</description></rule><rule id="979239fe-0058-529c-994b-2c761ee42304" name="Armour of Ugnÿr" publicationId="79c0cbf6-2602-pub1" hidden="false"><description>The wearer is immune to the effects of the Fleshbane and Poisoned special rules. If as a result the attack has no strength value, it wounds on a To Wound roll of a 6.</description></rule><rule id="42e85886-5540-561d-8dff-723bea8acfa8" name="Warlord Trait 1. Ancestral Bearing" publicationId="79c0cbf6-2602-pub1" hidden="false"><description>The Warlord gains the Resolute special rule, and friendly units within 12" of the Warlord also benefit from the Resolute special rule. In addition, when determining assault results for any of your units in combat, add 1 to your total if your Warlord is engaged in combat.</description></rule><rule id="5f2f599f-036a-5d1d-9f88-781462f66d9e" name="Warlord Trait 2. Warrior Lord" publicationId="79c0cbf6-2602-pub1" hidden="false"><description>The Warlord and any unit they join gain the Monster Hunter and Furious Charge special rules.</description></rule><rule id="737be677-e66b-56df-b304-cfb52b4587e0" name="Warlord Trait 3. A Long List" publicationId="79c0cbf6-2602-pub1" hidden="false"><description>The Warlord and the unit they join suffer the Hatred (Enemy Warlord) special rule. After deploying but before rolling to seize the initiative, place a single Grudge Token on the enemy Warlord's unit.</description></rule><rule id="ef96c345-e142-5d40-bffd-0f5469e14437" name="Warlord Trait 4. Guild Affiliate" publicationId="79c0cbf6-2602-pub1" hidden="false"><description>You may re-roll To Hit rolls of 1 when shooting and in combat for the Warlord and the unit they join.</description></rule><rule id="a58e4f01-e554-5a96-af64-a73b660af5eb" name="Warlord Trait 5. Unrelenting Toil" publicationId="79c0cbf6-2602-pub1" hidden="false"><description>Your units gain the Move Through Cover special rule. Your Warlord confers the Counter Attack special rule to them and their unit.</description></rule><rule id="77e1fd2b-e082-5c29-815b-891387957405" name="Warlord Trait 6. Grim Demeanour" publicationId="79c0cbf6-2602-pub1" hidden="false"><description>The Warlord gains the Fearless and the It Will Not Die special rules.</description></rule></sharedRules><sharedProfiles><profile typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon" id="1ae3d498-9f28-5d52-ac36-97b0c403f8fd" name="HYLas Auto Rifle" publicationId="79c0cbf6-2602-pub1" hidden="false"><characteristics><characteristic typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464" name="Range">18"</characteristic><characteristic typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45" name="Strength">6</characteristic><characteristic typeId="6abee736-f8d3-498e-97ac-a5c68445609f" name="AP">6</characteristic><characteristic typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2" name="Type">Assault 2</characteristic></characteristics></profile><profile typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon" id="806f2a3a-21ba-5102-9d8f-dfff9df78b9b" name="HYLas Beam Cannon" publicationId="79c0cbf6-2602-pub1" hidden="false"><characteristics><characteristic typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464" name="Range">36"</characteristic><characteristic typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45" name="Strength">6</characteristic><characteristic typeId="6abee736-f8d3-498e-97ac-a5c68445609f" name="AP">2</characteristic><characteristic typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2" name="Type">Heavy 2, Lance</characteristic></characteristics></profile><profile typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon" id="83036bc8-e336-5230-93ff-58f8071fa213" name="HYLas Rotary Cannon" publicationId="79c0cbf6-2602-pub1" hidden="false"><characteristics><characteristic typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464" name="Range">24"</characteristic><characteristic typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45" name="Strength">6</characteristic><characteristic typeId="6abee736-f8d3-498e-97ac-a5c68445609f" name="AP">4</characteristic><characteristic typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2" name="Type">Heavy 3, Sunder</characteristic></characteristics></profile><profile typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon" id="b9ef9a85-7497-5cdd-8181-e8da5df4976e" name="EtaCarn Plasma Beamer" publicationId="79c0cbf6-2602-pub1" hidden="false"><characteristics><characteristic typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464" name="Range">18"</characteristic><characteristic typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45" name="Strength">7</characteristic><characteristic typeId="6abee736-f8d3-498e-97ac-a5c68445609f" name="AP">2</characteristic><characteristic typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2" name="Type">Heavy 2, Gets Hot</characteristic></characteristics></profile><profile typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon" id="912f2403-1214-55b0-b7b3-7e4c71182682" name="EtaCarn Plasma Gun" publicationId="79c0cbf6-2602-pub1" hidden="false"><characteristics><characteristic typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464" name="Range">18"</characteristic><characteristic typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45" name="Strength">7</characteristic><characteristic typeId="6abee736-f8d3-498e-97ac-a5c68445609f" name="AP">2</characteristic><characteristic typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2" name="Type">Assault 1, Gets Hot</characteristic></characteristics></profile><profile typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon" id="ace42ef5-c474-5642-b604-c692f754988c" name="Volkanite Disintegrator" publicationId="79c0cbf6-2602-pub1" hidden="false"><characteristics><characteristic typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464" name="Range">15"</characteristic><characteristic typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45" name="Strength">5</characteristic><characteristic typeId="6abee736-f8d3-498e-97ac-a5c68445609f" name="AP">6</characteristic><characteristic typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2" name="Type">Assault 2, Deflagrate</characteristic></characteristics></profile><profile typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon" id="b8622b45-c6c1-5a71-b2a8-b5adf99ab595" name="Heavy Volkanite Disintegrator" publicationId="79c0cbf6-2602-pub1" hidden="false"><characteristics><characteristic typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464" name="Range">30"</characteristic><characteristic typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45" name="Strength">6</characteristic><characteristic typeId="6abee736-f8d3-498e-97ac-a5c68445609f" name="AP">5</characteristic><characteristic typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2" name="Type">Heavy 2, Deflagrate</characteristic></characteristics></profile><profile typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon" id="d04f6b80-2103-59d2-8c2f-f92eb5d9cd79" name="Cyclic Ion Cannon" publicationId="79c0cbf6-2602-pub1" hidden="false"><characteristics><characteristic typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464" name="Range">36"</characteristic><characteristic typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45" name="Strength">7</characteristic><characteristic typeId="6abee736-f8d3-498e-97ac-a5c68445609f" name="AP">3</characteristic><characteristic typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2" name="Type">Heavy 3, Blast(3")</characteristic></characteristics></profile><profile typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon" id="15fbc7a2-7b63-56c0-92f5-50aa1ee17a30" name="Ion Beamer" publicationId="79c0cbf6-2602-pub1" hid